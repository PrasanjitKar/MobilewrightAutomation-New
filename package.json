{
  "name": "ctp-contiplus-web-qa-mobilewright-automation",
  "version": "1.0.0",
  "description": "conti+ mobilewright typescript framework",
  "license": "ISC",
  "author": "Ostan Dsouza",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "bddgen": "bddgen",
    "test": "npm run bddgen && mobilewright test",
    "test:android": "PLATFORM=android npm run bddgen && PLATFORM=android mobilewright test --project=android",
    "test:ios": "PLATFORM=ios npm run bddgen && PLATFORM=ios mobilewright test --project=ios",
    "test:tag": "npm run bddgen && mobilewright test --grep",
    "init": "node src/report/custom/init.ts",
    "device:check": "adb devices",
    "device:restart": "adb kill-server && adb start-server",
    "clean:results": "rm -rf test-results",
    "clean:features": "rm -rf .features-gen",
    "clean:all": "npm run clean:results && npm run clean:features",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "keywords": [
    "mobile-testing",
    "automation",
    "mobilewright"
  ],
  "dependencies": {
    "@mobilewright/test": "^0.0.44",
    "mobilewright": "^0.0.44"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "winston": "^3.19.0",
    "dotenv": "^17.4.2",
    "playwright-bdd": "^9.1.0"
  }
}
